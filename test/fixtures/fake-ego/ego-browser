#!/usr/bin/env node
// 假 ego-browser：`ego-browser nodejs` 从 stdin 读脚本，交给 service.mjs 在 mock 的 Ego 全局函数下执行。
// 跟真 Ego 一样，脚本不在 CLI 进程里跑：service 是 detached 的子进程，杀掉这个 CLI 不会停掉脚本。
// CLI 把 service 的输出转到自己的 stderr（真 CLI 也把脚本的 console.log 写到 stderr），退出码跟随脚本。
// 环境变量见 service.mjs。
import { spawn } from 'node:child_process';
import { mkdtempSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';

const SERVICE = fileURLToPath(new URL('./service.mjs', import.meta.url));
let src = '';
for await (const c of process.stdin) src += c;
const file = join(mkdtempSync(join(tmpdir(), 'fake-ego-script-')), 'script.js');
writeFileSync(file, src);
const child = spawn(process.execPath, [SERVICE, file], { detached: true, stdio: ['ignore', 'pipe', 'pipe'] });
child.stdout.pipe(process.stderr);
child.stderr.pipe(process.stderr);
child.on('close', (code) => process.exit(code ?? 1));
